{
  "name": "classifieds-backend",
  "version": "1.0.0",
  "description": "REST API backend service for classifieds app",
  "main": "dist/server.js",
  "keywords": [],
  "author": "Andrii Toptun <a.toptun@gmail.com>",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc --noEmit && tsup",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "dev:db": "docker compose up",
    "dev:db:stop": "docker compose stop",
    "prod:up": "docker compose -f compose.yml -f compose.prod.yml up --build -d",
    "prod:down": "docker compose -f compose.yml -f compose.prod.yml down",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^7.10.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
