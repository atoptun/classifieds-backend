{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    // "rootDir": "./src",
    "outDir": "./dist",

    "paths": {
      "@/*": ["./src/*"],
      "@db/client": ["./src/generated/prisma/client.ts"],
      "@db/*": ["./src/db/*"]
    },

    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "sourceMap": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "./src/**/*.ts",
    "./tests/**/*.ts",
    "./scripts/**/*.ts",
    "prisma.config.ts",
    "prisma/seed.ts",
    "tsup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": []
}
